# ローカル開発（APP_MODE=local）の設定例。秘密情報は書かない。
# `pnpm dev` / `pnpm test` はこのファイルが無くても既定値で動作する（AWS認証情報は不要・使用しない）。
# 値を変えたい場合のみ、シェルの環境変数として指定する（例: APP_ORIGIN=... pnpm dev）。

# --- 共通（ローカルは MiniStack を必ず使う。AWS実キー・SSOへのフォールバックは禁止） ---
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true

# --- BFF (apps/api) ---
APP_MODE=local
# ブラウザで開くURLと完全一致させる（Codespaces 等の転送URLで開く場合はそのURLに変更）
APP_ORIGIN=http://localhost:5173
AUTH_BACKEND=dev-auth            # ローカル専用。確認コードは 000000
AGENT_BACKEND=local-strands
LOCAL_AGENT_URL=http://localhost:8080
DATA_TABLE_NAME=chat-app-local-data
SESSION_TABLE_NAME=chat-app-local-session
QUOTA_DAILY_REQUESTS=20
QUOTA_HOURLY_REQUESTS=10
QUOTA_DAILY_SEARCHES=20
QUOTA_TIMEZONE=Asia/Tokyo
LOG_LEVEL=info

# --- Agent (apps/agent) ---
MODEL_PROVIDER=fixed             # ローカルは固定モデル（外部LLMを呼ばない）
SEARCH_BACKEND=fixture           # local/fixtures/search/*.json
FIXED_MODEL_CHUNK_DELAY_MS=15
