{
  "name": "ai-chat-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT風AIチャットWebアプリのスターターキット（React/Vite + Hono BFF + Cognito メールOTP + Bedrock AgentCore + Strands Agents TypeScript）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx local/launch.ts",
    "test": "tsx scripts/test-all.ts",
    "infra:local:up": "docker compose -f local/docker-compose.yml up -d --wait",
    "infra:local:down": "docker compose -f local/docker-compose.yml down",
    "local:seed": "tsx local/seed.ts",
    "local:reset": "tsx local/reset.ts",
    "test:unit:web": "pnpm --filter web test:unit",
    "test:unit:backend": "pnpm --filter api test:unit && pnpm --filter agent test:unit && pnpm --filter \"./packages/*\" test:unit && pnpm --filter infra test:unit",
    "test:unit": "pnpm test:unit:web && pnpm test:unit:backend",
    "test:integration": "vitest run --config tests/vitest.integration.config.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:exploratory": "tsx scripts/run-e2e.ts --exploratory",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:aws-smoke": "tsx tests/aws-smoke/smoke.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "pnpm build:web && pnpm build:api && pnpm build:agent",
    "build:web": "pnpm --filter web build",
    "build:api": "tsx scripts/build-api.ts",
    "build:agent": "tsx scripts/build-agent.ts",
    "cdk:synth": "pnpm build && pnpm --filter infra cdk:synth",
    "cdk:diff": "pnpm build && pnpm --filter infra cdk:diff",
    "smoke": "tsx scripts/smoke.ts",
    "delete-user": "tsx scripts/delete-user.ts",
    "deploy:aws": "tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "@ai-chat/agent-contracts": "workspace:*",
    "@ai-chat/contracts": "workspace:*",
    "@ai-chat/test-fixtures": "workspace:*",
    "@aws-sdk/client-cognito-identity-provider": "3.1157.0",
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0",
    "@e2e-dev/web": "0.15.3",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.5",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "e2e": "0.21.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "ulid": "3.0.2",
    "uuidv7": "1.2.1",
    "vitest": "5.0.5"
  }
}
